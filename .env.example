# المتغير الوحيد الذي تحتاجه في Railway (اختياري، إن لم تضعه سيعمل بـ SQLite تلقائياً):
DATABASE_URL=sqlite+aiosqlite:///./bot_database.db
# أو عند استخدام PostgreSQL على Railway:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:port/dbname

# متغيرات حدود وسرعة الإرسال (اختيارية ولها قيم افتراضية):
DEFAULT_DELAY_BETWEEN_TARGETS=1.5
MAX_REPEAT_LIMIT=50
MAX_TARGETS_LIMIT=500
