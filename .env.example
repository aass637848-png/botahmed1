# Telegram Bot Configuration
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz_SAMPLE_TOKEN

# Super Admin Telegram ID (Numeric ID, comma-separated if multiple: 12345678,87654321)
ADMIN_IDS=123456789

# Database URL
# For SQLite (default):
DATABASE_URL=sqlite+aiosqlite:///./bot_database.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/bot_db

# Default Timezone for campaign scheduling (e.g., Africa/Cairo, Asia/Riyadh, Europe/London, UTC)
DEFAULT_TIMEZONE=Africa/Cairo

# Broadcast Rate Limiting & Defaults
DEFAULT_DELAY_BETWEEN_TARGETS=1.5
MAX_RETRY_ATTEMPTS=3
